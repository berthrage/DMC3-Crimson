    <CheatEntry>
      <ID>3546</ID>
      <Description>"FixCerberusCollisions"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : dmc3.exe
  Version: 
  Date   : 2026-07-16
  Author : bibic

  This script does blah blah blah
}

define(address,"dmc3.exe"+22FAFB)
define(frameRateMult, Crimson.g_FrameRateTimeMultiplier)
define(bytes,F3 0F 10 15 69 DA 12 00)

[ENABLE]

assert(address,bytes)
alloc(newmem,$1000,"dmc3.exe"+22FAFB)

label(code)
label(return)

newmem:
dd (float)0.01

code:
  push rdx
  movdqu [rsp+10], xmm1 // preserve registers

  mov rdx, frameRateMult
  movss xmm1, dword ptr [rdx] // load frameratemult

  movss xmm2, xmm1

  movdqu xmm1, [rsp+10]
  pop rdx

  jmp return

address:
  jmp code
  nop 3
return:

[DISABLE]

address:
  db bytes
  // movss xmm2,[dmc3.exe+35D56C]

dealloc(newmem)

{
