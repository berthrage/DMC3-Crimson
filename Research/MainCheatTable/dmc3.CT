[ENABLE]

aobscanmodule(ffsdsfd,dmc3.exe,C6 83 78 63 00 00 01) // should be unique
alloc(newmem,$1000,ffsdsfd)
label(code)
label(return)
registersymbol(guardgrav)
label(guardgrav)

newmem:
guardgrav:
dd (float)0
dd (float)0.7
closeToZeroMult:
dd (float)0.1

code:
// Original code, write air guard 1
  mov byte ptr [rbx+00006378],01
  jmp skipInertia
{
// Don't apply inertia if flag is set
  cmp byte ptr [inertiaBackup+8],00
  je return

//////////////////////////////////

// Apply saved inertia
  push eax
  mov eax,[inertiaBackup]
  mov [rbx+000001C0],eax

  mov eax,[inertiaBackup+4]
  mov [rbx+3ed0],eax
  cmp eax,0
  pop eax
}
//////////////////////////////////
skipInertia:
// Test for held jump button
  cmp dword ptr [rbx+94],0
  jl return
  test [rbx+74e0],0040
  jne code2
// Jump not held
  movss xmm0,[rbx+94]
  mulss xmm0,[newmem]
  movss [rbx+94], xmm0
  jmp return

// Jump held
code2:
  movss xmm0,[rbx+94]
  mulss xmm0,[newmem+4]
  movss [rbx+94], xmm0
  jmp return

ffsdsfd:
  jmp code
  nop 2
return:
registersymbol(ffsdsfd)

[DISABLE]
ffsdsfd:
  db C6 83 78 63 00 00 01
unregistersymbol(ffsdsfd)
dealloc(newmem)
unregistersymbol(guardgrav)

// ORIGINAL CODE - INJECTION POINT: dmc3.exe+1EE121
</AssemblerScript>
