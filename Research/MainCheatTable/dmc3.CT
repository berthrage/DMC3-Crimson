  <Comments>dmc3.exe+1E779A dt
dmc3.exe+1E6A67 gun
dmc3.exe+2BB11E style bar stuff
</Comments>
  <LuaScript>local app = getAddress("dmc3.exe")

local p1 = readQword(app + 0xC18AF8)
local p2 = p1 and readQword(p1 + 0xC90E28) or 0
local player = p2 and readQword(p2 + 0x18) or 0
if player == 0 then error("playerBase is null") end

local devil = readBytes(player + 0x3E9B, 1, false) or 0
local mirror = readInteger(player + 0x3E88) or 0
local entity = readBytes(player + 0x1CACE, 1, false) or 0

local slot = 13
if devil ~= 0 or entity ~= 0 then
  slot = slot + (0x18 * mirror)
end

local meta = readQword(player + 0xE5D0 + slot * 8) or 0
local phys = meta ~= 0 and (readQword(meta + 0x110) or 0) or 0

print(string.format("player=%X devil=%d entity=%d mirror=%d slot=%d meta=%X phys=%X",
  player, devil, entity, mirror, slot, meta, phys))

local meta = 0x88D5640
local phys = readQword(meta + 0x110)
print(string.format("physicsData = %X", phys))

</LuaScript>
