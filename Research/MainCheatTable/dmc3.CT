aobscanmodule(gfddfg,dmc3.exe,8E FE FF FF C0 48 8B 94 C3 D0 E5 00 00) // should be unique
alloc(newmem,$1000,gfddfg)

label(code)
label(return)

newmem:

code:
  mov rdx,[rbx+rax*8+0000E5D0]
  mov rcx,[rdx+00000110]
  mov [rdi+000000C0],rcx // play effect
  xor edx,edx
  mov [rsp+20],esi
  inc byte ptr [rbx+00003E10] // end effect
  mov rdi,[rsp+58] // crashes without
  mov rsi,[rsp+50] // probably crashes without
  add rsp,40
  pop rbx
  ret


gfddfg+05:
  jmp newmem
  nop 3
return:
registersymbol(gfddfg)

[DISABLE]

