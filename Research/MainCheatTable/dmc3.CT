plus:
  movss xmm6,[newmem+4]
  jmp originalcodepop

minus:
  movss xmm6,[newmem]
  jmp originalcodepop

originalcodepop:
  pop rbx
originalcode:
  movss [rdi+00000184],xmm6
  jmp return

