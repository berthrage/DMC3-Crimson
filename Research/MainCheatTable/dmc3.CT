          <Description>"Play Effect Old"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
alloc(calleffect,128,dmc3.exe)
createthread(calleffect)
registersymbol(calleffect)
calleffect:
// player in rbx and rdi

mov rbx,[dmc3.exe+C18AF8]
mov rbx,[rbx+C90E28]
mov rbx,[rbx+18] // player
jmp thang2
//ret

thang:
mov rbp,rsp
sub rsp,20
call dmc3.exe+2E7CA0 // from dmc3.exe+211B95, million stab. another example at dmc3.exe+20167F for ora ora
mov rsp,rbp
ret

thang2:
mov rcx,3
mov rdx,90
mov rsi,0
mov rdi,rbx
mov r8,0
mov r9,8
mov r10,[dmc3.exe] // wtf

mov rax,[rbx+00003DF8]
lea r9d,[rsi+08]
mov edx,00000090
lea ecx,[rsi+03]
xor r8d,r8d
movss xmm2,[rax+00000094]
movss xmm1,[rax+00000090]
movss xmm0,[rax+0000008C]
movss [rbx+0000B898],xmm0
movss [rbx+0000B89C],xmm2
movss [rbx+0000B8A0],xmm1
movss [rbx+0000B8A4],xmm2
mov [rbx+0000B8A8],si
mov [rbx+00003E34],41200000
mov [rbx+00003E2A],sil

call dmc3.exe+2E7CA0 // from dmc3.exe+211B95
ret

[DISABLE]
dealloc(calleffect)
unregistersymbol(calleffect)

