  cmp byte ptr [rdi+3fa4], #146 // C shotty-stinger
  je MovC_Label
  cmp byte ptr [rdi+3fa4], #154 // D artemis-sphere
  je MovD_Label
  cmp byte ptr [rdi+3fa4], #161 // E spiral-sniper
  je MovE_Label
