      <AssemblerScript>{ Game   : dmc3.exe
  Version: 
  Date   : 2023-11-11
  Author : sssiy_8fxwi52

  This script does blah blah blah
}

[ENABLE]
// DT hold is dmc3.exe+1E75BC - 66 85 8F E0740000     - test [rdi+000074E0],cx
aobscanmodule(DTMapping,dmc3.exe,0F B7 44 45 0A 66 85 87 E6 74 00 00 75) // should be unique
alloc(newmem,$1000,DTMapping)
label(code)
label(return)

newmem:
  dw 0080
newmem2:
  cmp dword ptr [rbx+78], 3 // vergil
  jne code
  movzx eax,word ptr [newmem]
  jmp return

code:
  movzx eax,word ptr [rbp+rax*2+0A]
  jmp return

DTMapping:
  jmp newmem2
return:
registersymbol(DTMapping)

[DISABLE]
DTMapping:
  db 0F B7 44 45 0A
unregistersymbol(DTMapping)
dealloc(newmem)

