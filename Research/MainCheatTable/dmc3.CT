[ENABLE]

aobscanmodule(ChargeControls,dmc3.exe,F3 0F 58 46 08 0F) // should be unique
alloc(newmem,$1000,ChargeControls)

label(code)
label(return)

newmem:
  // cmp rax,4 // button compare, only 4 when melee is held
  // je return

  // only affect reb charge offset
  push rdx
  mov rdx,[dmc3.exe+168]
  mov rdx,[rdx+C90E28]
  mov rdx,[rdx+18] // player
  lea rdx,[rdx+66a4] // drive charge base
  cmp rsi,rdx
  pop rdx
  je return

code:
  addss xmm0,[rsi+08]
  jmp return

ChargeControls:
  jmp newmem
return:
registersymbol(ChargeControls)

