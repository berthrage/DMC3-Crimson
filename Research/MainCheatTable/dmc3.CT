      <ID>1664</ID>
      <Description>"Sword Effect Call Test"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
alloc(calleffect,128,dmc3.exe)
registersymbol(calleffect)
createthread(calleffect)
calleffect:
  push rdi
  mov rdi,[dmc3.exe+C18AF8]
  mov rdi,[rdi+C90E28]
  test rdi,rdi
  je return
  mov rdi,[rdi+18] // player


  xor rax,rax
  mov rcx, [rdi+rax*8+1C9F0]
  test rcx,rcx
  je return
  cmp [rcx+00000111],r14l
  je return
  mov rcx,rdi
  call dmc3.exe+1F78B0
  xor edx,edx

  mov rbx,[rdi+3C50]
  mov rcx,rdi
  lea r8d,[rdx+01]
  test al,al
  jne return

  call dmc3.exe+1FAC90 // sets rax
  mov ecx,14 // id
  mov rdx,[rax+00000110]
  mov r9,rdi
  mov r8,rbx
  call dmc3.exe+8BF40 // from dmc3.exe+215923
  inc byte ptr [rdi+0000B87B]
  mov edx,00000004
  mov rcx,rdi
  call dmc3.exe+1EB860

  movsxd  rax,dword ptr [rdi+00006490]


return:
  pop rdi
  ret

[DISABLE]
dealloc(calleffect)
unregistersymbol(calleffect)

