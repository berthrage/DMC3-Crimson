        <CheatEntry>
          <ID>2504</ID>
          <Description>"Play Effect original"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
alloc(calleffect,128,dmc3.exe)
createthread(calleffect)
registersymbol(calleffect)
calleffect:
// player in rbx and rdi
  push rbx
  mov rbx,[dmc3.exe+C18AF8]
  mov rbx,[rbx+C90E28]
  mov rbx,[rbx+18] // player
  //mov rax,[rbx+3df8]
  jmp thang

thang:
  sub rsp,40
  mov rcx,3  // bank
  mov rdx,90 // id
  mov rsi,0
  mov rdi,rbx
  mov r8,0
  mov r9,8
  call dmc3.exe+2E7CA0 // from dmc3.exe+211B95
  mov rdi,rax
  test rax,rax
  je return
  mov rcx,rbx
  call dmc3.exe+1FAA50
  mov ecx,FF0000FF
  inc eax // y pos
  mov rdx,[rbx+rax*8+0000E5D0] // get ptr to player
  mov rcx,[rdx+00000110] // get player xyz
  mov [rdi+000000C0],rcx // write player xyz

  mov [rdi+000000D8],esi
  xor edx,edx
  mov [rsp+30],esi
  lea r9,[rbx+00000080]
  mov [rsp+28],esi
  mov byte ptr [rcx],04
  lea rcx,[dmc3.exe+D6DC90]
  mov [rsp+20],esi
  lea r8d,[rdx+50]
  call dmc3.exe+339320
  //inc byte ptr [rbx+00003E10] // inc current move part
  mov rdi,[rsp+58]
  mov rsi,[rsp+50]
  add rsp,40
return:
  pop rbx
  ret

[DISABLE]
dealloc(calleffect)
unregistersymbol(calleffect)

</AssemblerScript>
        </CheatEntry>
