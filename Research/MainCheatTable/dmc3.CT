      <AssemblerScript>{ Game   : dmc3.exe
  Version: 
  Date   : 2023-10-18
  Author : sssiy_8fxwi52

  This script does blah blah blah
}

[ENABLE]

aobscanmodule(fgdgfhfgh,dmc3.exe,F3 0F 11 B7 84 01 00 00) // should be unique
alloc(newmem,$1000,fgdgfhfgh)

label(code)
label(return)

newmem:
dd (float)300
dd (float)-100

code:
  push rbx
  mov rbx,[dmc3.exe+C18AF8]
  mov rbx,[rbx+C90E28]
  mov rbx,[rbx+18] // player
  cmp byte ptr [rbx+74fa],#80 // stick push amount
  jb originalcodepop

  cmp byte ptr [rbx+74f9],#32
  jbe minus
  cmp byte ptr [rbx+74f9],#223
  jae minus

  cmp byte ptr [rbx+74f9],#159
  jbe untouched
  jmp originalcodepop

untouched:
  cmp byte ptr [rbx+74f9],#96
  jae plus
  jmp originalcodepop

plus:
  movss xmm6,[newmem+4]
  jmp originalcodepop

minus:
  movss xmm6,[newmem]
  jmp originalcodepop

originalcodepop:
  pop rbx
originalcode:
  movss [rdi+00000184],xmm6
  jmp return

fgdgfhfgh:
  jmp code
  nop 3
return:
registersymbol(fgdgfhfgh)

[DISABLE]

fgdgfhfgh:
  db F3 0F 11 B7 84 01 00 00

unregistersymbol(fgdgfhfgh)
