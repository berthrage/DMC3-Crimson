  cmp r14,8 // second hp red
  je newmem3
  cmp r14,9 // second hp green
  je newmem3
  cmp r14,A // second hp separators
  je newmem3
  jmp code

newmem3:
  movss xmm1,[newmem]

code:
  movss [rbx-2C],xmm1
  jmp return

dfgjdfgs:
  jmp newmem2
return:
registersymbol(dfgjdfgs)

