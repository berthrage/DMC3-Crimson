        <CheatEntry>
          <ID>3186</ID>
          <Description>"Play Effect SWORD"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
alloc(calleffect,128,dmc3.exe)
registersymbol(calleffect)
createthread(calleffect)
calleffect:
  push rbx
  mov rbx,[dmc3.exe+C18AF8]
  mov rbx,[rbx+C90E28]
  test rbx,rbx
  je return
  mov rbx,[rbx+18] // player
  mov rbx,[rbx+30] // sword
  mov rcx,3  // bank
  mov rdx,90 // id
  call dmc3.exe+2E7CA0 // from dmc3.exe+211B95, another example at dmc3.exe+20167F
  mov rdi,rax
  test rax,rax
  je return
  mov rcx,rbx
  call dmc3.exe+1FAA50
  xor rax,rax
  mov eax,[boneID]
  //mov rdx,[rbx+30]
  mov rdx,[rbx+rax*8+00000160] // get bone ptr
  mov rcx,[rdx+00000110]
  mov [rdi+000000C0],rcx
  mov [rdi+000000D8],esi
return:
  pop rbx
  ret

[DISABLE]
dealloc(calleffect)
unregistersymbol(calleffect)

// lightning is
  // mov rcx,2  // bank
