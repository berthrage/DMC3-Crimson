[ENABLE]
aobscanmodule(fgdghhg,dmc3.exe,89 81 C0 01 00 00 42) // should be unique
alloc(newmem,$1000,fgdghhg)
label(code)
label(return)
registersymbol(inertiaBackup)
label(inertiaBackup)

newmem:
inertiaBackup:
dd 0 // +0
dd 0 // +4
dd 0 // +8
newmem2:
// most moves will assume inertia is possible
  mov dword ptr [inertiaBackup+8],1

// few will back up inertia
  cmp r8,132 // jc
  je code2
  cmp r8,10E // jc + direction
  je code2
  //cmp r8,15f // jc + hold
  //je code2
  //cmp r8,13b // jc + direction + hold
  //je code2
  cmp r8,7e // air hike
  je code2
  cmp r8,5a // air hike + direction
  je code2
  //cmp r8,ab // air hike + hold &lt;- makes jumps retain jump inertia, bad
  //je code2
  //cmp r8,87 // air hike + direction + hold
  //je code2

// write flag to tell guard to reset inertia
  cmp r8,24 // jump
  je code3
  cmp r8,51 // jump + hold
  je code3
  cmp r8,00 // jump + direction
  je code3
  cmp r8,2d // jump + direction + hold
  je code3

// originalcode, use inertia
code:
  mov [rcx+000001C0],eax
  mov eax,[rdx+r8*4+3C]
  mov [rcx+000001C4],eax
  jmp return

// back up inertia
code2:
  push eax
  mov eax,[rcx+000001C0] // back up inertia
  mov [inertiaBackup],eax

  mov eax,[rcx+3ed0]
  mov [inertiaBackup+4],eax // back up inertia direction
  pop eax
  jmp code

// write flag to tell guard to reset inertia
code3:
  mov dword ptr [inertiaBackup+8],0
  jmp code

fgdghhg:
  jmp newmem2
  nop
  nop 5
  nop 6

return:
registersymbol(fgdghhg)

[DISABLE]

fgdghhg:
  db 89 81 C0 01 00 00 42 8B 44 82 3C 89 81 C4 01 00 00

unregistersymbol(fgdghhg)
dealloc(newmem)
unregistersymbol(inertiaBackup)
