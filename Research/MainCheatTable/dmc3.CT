alloc(calleffect,128,dmc3.exe)
registersymbol(calleffect)
createthread(calleffect)
calleffect:
  push rbx
  mov rbx,[dmc3.exe+C18AF8]
  mov rbx,[rbx+C90E28]
  test rbx,rbx
  je return
  mov rbx,[rbx+18] // player
  mov rcx,2  // bank
  mov rdx,100  // id // 268 blue glow // 2+2A sword red white
  //mov r9,C0 // ?
  call dmc3.exe+2E7CA0 // from dmc3.exe+211B95, another example at dmc3.exe+20167F
  mov rdi,rax
  test rax,rax
  je return
  mov rcx,rbx
  call dmc3.exe+1FAA50 // sets rax, rcx, eax
  mov eax,[boneID]
  mov rdx,[rbx+rax*8+0000E5D0] // get ptr to player
  mov rcx,[rdx+00000110] // player xyz
  mov [rdi+000000C0],rcx
  mov [rdi+000000D8],esi
return:
  pop rbx
  ret

[DISABLE]
