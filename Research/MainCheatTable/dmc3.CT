label(code)
label(return)

newmem:
dq 0 // ID
dd (float)50 // stinger // above this
dd (float)0 // stinger // below this
dd (float)500 // combo b // above this
dd (float)510 // combo b // below this
newmem2:
  test [rdi+000074E0],ax
  je dmc3.exe+1EB7FE

  cmp byte ptr [rdi+3fa4], 8
  je Stinger
  cmp byte ptr [rdi+3fa4], 4
  je ComboB
  jmp code

Stinger:
  mov byte ptr [newmem], 1*8
  jmp SetCrazyComboTiming

ComboB:
  mov byte ptr [newmem], 2*8
  jmp SetCrazyComboTiming

SetCrazyComboTiming:
  sub rsp,8
  movss [rsp], xmm0
  movss [rsp+4],xmm1
  push rax
  push rbx
  xor rax,rax
  xor rbx,rbx
  lea rax,[newmem]
  mov rbx,[newmem]
  movss xmm0,[rdi+bf88] // current anim frame
  movss xmm1,[rax+rbx] // when can we cancel stinger
  pop rbx
  pop rax
  movss xmm1,[rsp+4]
  comiss xmm0,xmm1
  add rsp,8
  movss xmm0,[rsp]
  ja dmc3.exe+1EB7FE
  mov byte ptr [rsi+04],6
  jmp dmc3.exe+1EB7FE

SetCrazyComboTimingTwo:
  sub rsp,8
  movss [rsp], xmm0
  movss [rsp+4],xmm1
  push rax
  push rbx
  xor rax,rax
  xor rbx,rbx
  lea rax,[newmem]
  mov rbx,[newmem]
  movss xmm0,[rdi+bf88] // current anim frame
  movss xmm1,[rax+rbx] // when can we cancel stinger
  pop rbx
  pop rax
  comiss xmm0, xmm1
  movss xmm1,[rsp+4]
  movss xmm0,[rsp]
  add rsp,8
  ja dmc3.exe+1EB7FE

  sub rsp,8
  movss [rsp], xmm0
  movss [rsp+4],xmm1
  push rax
  push rbx
  xor rax,rax
  xor rbx,rbx
  lea rax,[newmem]
  mov rbx,[newmem]
  add rbx,4
  movss xmm0,[rdi+bf88] // current anim frame
  movss xmm1,[rax+rbx*8] // when can we cancel stinger
  pop rbx
  pop rax
  comiss xmm0, xmm1
  movss xmm1,[rsp+4]
  movss xmm0,[rsp]
  add rsp,8
  jb dmc3.exe+1EB7FE

  mov byte ptr [rsi+04],6
  jmp return

code: // modified originalcode for other moves
  test [rdi+000074E0],ax
  je dmc3.exe+1EB7FE
  mov byte ptr [rsi+04], 6
  jmp return

fcghfgh:
  jmp newmem2
  nop 7
return:
