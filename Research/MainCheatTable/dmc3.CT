label(code)
label(return)
label(scaleValue)

newmem:

  // -------------------------
  // Scale matrix (rbx+140h)
  // -------------------------
  lea rax,[rbx+140]

  movss xmm0,[scaleValue]
  shufps xmm0,xmm0,0   // broadcast

  // Row 0 (Right)
  movups xmm1,[rax]
  mulps xmm1,xmm0
  movups [rax],xmm1

  // Row 1 (Up)
  movups xmm1,[rax+10]
  mulps xmm1,xmm0
  movups [rax+10],xmm1

  // Row 2 (Forward)
  movups xmm1,[rax+20]
  mulps xmm1,xmm0
  movups [rax+20],xmm1

code:
  mov eax,[rbx+20]
  lea r9d,[rbp+08]
  jmp return

scaleValue:
  dd (float)10.0   // &lt;-- change scale here

address:
  jmp newmem
  nop 2

return:

[DISABLE]

address:
  db bytes

dealloc(newmem)
</AssemblerScript>
